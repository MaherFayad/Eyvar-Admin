{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyvar.internal/agent/schemas/ask.schema.json",
  "title": "AskResult",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "ar",
        "en"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "confidenceReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "confidence",
        "confidenceReason"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "seriesId": {
                  "type": "string",
                  "minLength": 1
                },
                "bucket": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "const": "total"
                    }
                  ]
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "count",
                    "money",
                    "percent",
                    "ratio",
                    "minutes",
                    "rating"
                  ]
                },
                "currency": {
                  "enum": [
                    "SAR",
                    null
                  ]
                }
              },
              "required": [
                "runId",
                "seriesId",
                "bucket",
                "value",
                "unit",
                "currency"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "chart": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "measures": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "aggregate": {
                          "enum": [
                            "count",
                            "sum",
                            "avg",
                            "end-of-period",
                            "cumulative-count"
                          ]
                        }
                      },
                      "required": [
                        "key"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "groupBy": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  },
                  "filters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1
                        },
                        "op": {
                          "enum": [
                            "eq",
                            "neq",
                            "in",
                            "nin",
                            "gt",
                            "gte",
                            "lt",
                            "lte",
                            "contains",
                            "between",
                            "isNull",
                            "isNotNull"
                          ]
                        },
                        "value": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            },
                            {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "field",
                        "op",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "window": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "preset"
                          },
                          "preset": {
                            "enum": [
                              "today",
                              "yesterday",
                              "last-7d",
                              "last-30d",
                              "last-90d",
                              "last-365d",
                              "last-month",
                              "last-12-months",
                              "last-year",
                              "this-quarter",
                              "last-quarter",
                              "this-year",
                              "year-to-date"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "preset"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "absolute"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "grain": {
                    "enum": [
                      "none",
                      "hour",
                      "day",
                      "week",
                      "month",
                      "quarter"
                    ]
                  },
                  "periodComparison": {
                    "oneOf": [
                      {
                        "enum": [
                          "none",
                          "previous-period",
                          "previous-quarter",
                          "previous-year"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "fixed"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "chartType": {
                    "enum": [
                      "line",
                      "area",
                      "bar",
                      "stacked-bar",
                      "stacked-100",
                      "horizontal-bar",
                      "pie",
                      "kpi",
                      "table"
                    ]
                  },
                  "formula": {
                    "type": "object"
                  },
                  "transform": {
                    "type": "object"
                  },
                  "segments": {
                    "type": "array",
                    "maxItems": 4
                  },
                  "comparisonDisplay": {
                    "enum": [
                      "series",
                      "difference",
                      "percent-change"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "trend",
                      "funnel",
                      "table",
                      "cohort",
                      "journey"
                    ]
                  },
                  "funnel": {
                    "type": "object"
                  },
                  "cohort": {
                    "type": "object"
                  },
                  "journey": {
                    "type": "object"
                  },
                  "table": {
                    "type": "object"
                  }
                },
                "required": [
                  "measures",
                  "groupBy",
                  "filters",
                  "window",
                  "grain",
                  "periodComparison",
                  "chartType"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "values",
          "evidence",
          "chart"
        ],
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "tested": {
            "const": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verdict": {
            "enum": [
              "supported",
              "not-supported",
              "inconclusive"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hypothesis",
          "tested",
          "evidence",
          "verdict",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "dataQuality": {
      "type": "object",
      "properties": {
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partialBucketsExcluded": {
          "const": true
        },
        "blockedSeries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "coverageNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "gaps",
        "partialBucketsExcluded",
        "blockedSeries",
        "truncated",
        "coverageNote"
      ],
      "additionalProperties": false
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "language",
    "question",
    "answer",
    "findings",
    "dataQuality",
    "followUps"
  ],
  "additionalProperties": false
}
