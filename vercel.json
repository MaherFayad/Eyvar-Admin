{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/**/*.ts": { "maxDuration": 60 },
    "api/cron/*.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/snapshot", "schedule": "5 21 * * *" },
    { "path": "/api/cron/alerts-hourly", "schedule": "0 * * * *" },
    { "path": "/api/cron/alerts-daily", "schedule": "15 3 * * *" },
    { "path": "/api/cron/alerts-digest", "schedule": "0 5 * * *" },
    { "path": "/api/cron/agent-schedules", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/housekeeping", "schedule": "30 2 * * *" }
  ],
  "headers": [
    {
      "source": "/pwa-kill-switch.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
